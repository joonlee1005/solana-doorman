# Copy this file to .env.local and fill in a devnet RPC URL from a provider
# (e.g. Helius, QuickNode, Alchemy, Syndica). The public api.devnet.solana.com
# endpoint is heavily rate-limited (429s) and not reliable for real usage.
#
# Helius free tier example:
#   1. https://dev.helius.xyz -> sign up -> create a project (devnet)
#   2. copy the RPC URL it gives you (looks like
#      https://devnet.helius-rpc.com/?api-key=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx)
#
# .env.local is gitignored (matches the *.local pattern) so your key never
# gets committed. If VITE_DEVNET_RPC is unset, the app falls back to the
# public devnet RPC.
VITE_DEVNET_RPC=https://devnet.helius-rpc.com/?api-key=YOUR_API_KEY_HERE
